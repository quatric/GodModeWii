+// devkitPro's libdvm passes no partition size: take it from the superblock (blocks << (10 + log_block_size)).
+static bool _ext4_part_size(DvmDisc* disc, sec_t start_sector, uint64_t* size)
+{
+	unsigned sector_sz = 1U << disc->sector_shift;
+	unsigned count = sector_sz >= 2048 ? 1 : 2048 / sector_sz;
+	uint8_t* buf = aligned_alloc(LIBDVM_BUFFER_ALIGN, count * sector_sz);
+	if (!buf || !disc->vt->read_sectors(disc, buf, start_sector, count)) {
+		free(buf);
+		return false;
+	}
+	const uint8_t* sb = buf + 1024;
+	bool ok = (sb[0x38] | sb[0x39] << 8) == 0xEF53;
+	uint64_t blocks = (uint32_t)(sb[4] | sb[5] << 8 | sb[6] << 16 | (uint32_t)sb[7] << 24);
+	if (sb[0x60] & 0x80) // INCOMPAT_64BIT: the high half of the block count
+		blocks |= (uint64_t)(uint32_t)(sb[0x150] | sb[0x151] << 8 | sb[0x152] << 16 | (uint32_t)sb[0x153] << 24) << 32;
+	uint32_t log = (uint32_t)(sb[0x18] | sb[0x19] << 8 | sb[0x1A] << 16 | (uint32_t)sb[0x1B] << 24);
+	free(buf);
+	if (!ok || log > 6)
+		return false;
+	*size = blocks << (10 + log);
+	return true;
+}
